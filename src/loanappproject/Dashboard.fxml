<AnchorPane prefHeight="835.0" prefWidth="1540.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="loanappproject.DashboardController">

