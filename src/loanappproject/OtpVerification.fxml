<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="340.0" prefWidth="380.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="loanappproject.OtpVerificationController">
    <children>
        <VBox layoutX="30.0" layoutY="30.0" prefWidth="320.0" spacing="16.0">
            <children>

                <Label text="Verify your email" textFill="#147211">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Label fx:id="emailLabel" text="We sent a code to your email." textFill="#555555" wrapText="true" />

                <TextField fx:id="otpField" prefHeight="46.0" promptText="Enter 6-digit code" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d9d9d9; -fx-padding: 10;">
                    <font>
                        <Font size="13.0" />
                    </font>
                </TextField>

                <Label fx:id="errorLabel" managed="false" textFill="#ff5252" visible="false" wrapText="true" />

                <Button fx:id="confirmButton" defaultButton="true" mnemonicParsing="false" onAction="#handleConfirm" prefHeight="46.0" prefWidth="320.0" style="-fx-background-color: #147211; -fx-background-radius: 10;" text="Confirm" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button mnemonicParsing="false" onAction="#handleResend" prefHeight="46.0" prefWidth="320.0" style="-fx-background-color: white; -fx-border-color: #d9d9d9; -fx-border-radius: 10; -fx-background-radius: 10;" text="Resend code" textFill="#1a2b4a">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

            </children>
        </VBox>
    </children>
</AnchorPane>
