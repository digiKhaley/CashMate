<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="480.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="loanappproject.PrivacyPolicyController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" spacing="10.0">
            <children>
                <Label text="Privacy Policy &amp; Terms">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <ScrollPane fitToWidth="true" prefHeight="380.0" prefWidth="440.0" style="-fx-background-color: transparent;">
                    <content>
                        <VBox spacing="12.0" style="-fx-padding: 10;">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="1. Information We Collect" wrapText="true" />
                                <Label text="We collect the personal details you provide when signing up (name, email, phone number) and when submitting a loan or KYC request (home address, income range, ID type, and a copy of your government-issued ID)." wrapText="true" />

                                <Label style="-fx-font-weight: bold;" text="2. How We Use Your Information" wrapText="true" />
                                <Label text="Your information is used to verify your identity (KYC), assess loan eligibility, process loan requests, and communicate updates about your loan status." wrapText="true" />

                                <Label style="-fx-font-weight: bold;" text="3. Loan Interest &amp; Repayment Terms" wrapText="true" />
                                <Label text="Interest is calculated based on your selected loan duration: 10% for loans of 1 year or less, 11% for loans of more than 1 year up to 2 years, 13% for loans of more than 2 years up to 3 years, 14% for loans of more than 3 years up to 4 years, and 15% for loans of more than 4 years. Interest is applied to the full loan amount for the entire loan duration. Loans must be repaid in full by the stated repayment date." wrapText="true" />

                                <Label style="-fx-font-weight: bold;" text="4. KYC Verification" wrapText="true" />
                                <Label text="You must submit a valid form of ID (NIN, Driver's License, International Passport, PVC or Utility Bill) along with a clear image of it. Submissions are reviewed by an administrator and may be Verified or Rejected. Loans cannot be disbursed until your KYC is Verified." wrapText="true" />

                                <Label style="-fx-font-weight: bold;" text="5. Data Storage &amp; Security" wrapText="true" />
                                <Label text="Your data is stored securely and is only accessible to authorized administrators for the purpose of loan and KYC review. We do not sell or share your personal information with third parties." wrapText="true" />

                                <Label style="-fx-font-weight: bold;" text="6. Your Consent" wrapText="true" />
                                <Label text="By checking the agreement box on the sign-up page, you confirm that you have read and agree to this Privacy Policy and these Terms." wrapText="true" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="34.0" prefWidth="440.0" style="-fx-background-color: #147211; -fx-background-radius: 8;" text="Close" textFill="WHITE" />
            </children>
        </VBox>
    </children>
</AnchorPane>
