<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="180.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="loanappproject.KYCUnverifiedPopupController">
    <children>
        <VBox layoutX="25.0" layoutY="20.0" spacing="12.0">
            <children>
                <Label fx:id="titleLabel" text="KYC Unverified" textFill="#ff4d00">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label fx:id="bodyLabel" text="Verify your KYC before you're eligible to get a loan." wrapText="true" />
                <Button fx:id="verifyNowButton" defaultButton="true" mnemonicParsing="false" onAction="#handleVerifyNow" prefHeight="34.0" prefWidth="240.0" style="-fx-background-color: #147211; -fx-background-radius: 8;" text="Verify KYC Now" textFill="WHITE" />
                <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="34.0" prefWidth="240.0" style="-fx-background-color: #dddddd; -fx-background-radius: 8;" text="Cancel" />
            </children>
        </VBox>
    </children>
</AnchorPane>
