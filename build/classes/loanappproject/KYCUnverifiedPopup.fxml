<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="224.0" prefWidth="340.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="loanappproject.KYCUnverifiedPopupController">
    <children>
        <VBox alignment="CENTER" layoutX="30.0" layoutY="28.0" prefWidth="280.0" spacing="16.0">
            <children>

                <Label fx:id="titleLabel" text="KYC Unverified" textFill="#ff4d00">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <Label fx:id="bodyLabel" text="Verify your KYC before you're eligible to get a loan." textFill="#555555" wrapText="true" />

                <Button fx:id="verifyNowButton" defaultButton="true" mnemonicParsing="false" onAction="#handleVerifyNow" prefHeight="38.0" prefWidth="280.0" style="-fx-background-color: #147211; -fx-background-radius: 10;" text="Verify KYC Now" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="280.0" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8;" text="Cancel" textFill="#666666" />

            </children>
        </VBox>
    </children>
</AnchorPane>
